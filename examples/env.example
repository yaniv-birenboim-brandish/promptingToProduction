# ---------------------------------------------------------------------------
# FamAlbum environment variables
#
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# That is intentional and safe for the two below. See CLAUDE.md > Security.
# ---------------------------------------------------------------------------

# Your project's REST URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "publishable" key. This key SHIPS TO THE BROWSER BY DESIGN.
# It is not a secret. Row Level Security is what makes it safe — a stolen anon
# key can only do what your RLS and Storage policies allow an anonymous or
# logged-in user to do. Session 2 covers this in depth.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NEVER put the service_role key in this file or anywhere under src/.
# It bypasses RLS entirely. It belongs only in server-side environments
# (Netlify Function env vars), and we do not need it at all in v1.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=   <-- do not add this
