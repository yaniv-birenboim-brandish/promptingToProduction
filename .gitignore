# Saved copies of third-party design references (see resources/README.md).
# Kept out of version control on purpose — they contain the full assets of
# commercial templates and shouldn't be redistributed with this repo.
resources/*.mhtml
resources/*.html
resources/vendor/

# The purchased JPhotolio theme bundle. The license covers the buyer's use,
# not redistribution — committing it would hand the paid product to everyone
# who clones this repo. It stays local, always.
resources/jphotolio-html-bundle/

# Local-only theme assets (photos, textures, logo) served by the app and the
# react-template from their public/ folders. Same licensing rule as above.
# Ignored at the root so they never show as untracked on branches that don't
# track the nested public/*/.gitignore files.
public/
resources/react-template/public/theme/*.png
resources/react-template/public/fixtures/*.jpg
